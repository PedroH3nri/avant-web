{
  "name": "avant-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build && ENTRY=tag vite build --config vite.embed.config.ts && ENTRY=reward vite build --config vite.embed.config.ts",
    "typecheck": "vue-tsc -b",
    "lint": "oxlint src",
    "clean-code": "node scripts/clean-code.mjs",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@vueuse/core": "^15.0.0",
    "avant-tag": "github:PedroH3nri/avant-tag#v0.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.1.0",
    "qrcode": "1.5.4",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/qrcode": "1.5.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "autoprefixer": "^10.6.2",
    "jsdom": "^31.0.1",
    "oxlint": "^1.94.0",
    "postcss": "^8.5.33",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "pnpm": {
    "overrides": {
      "glob": "^14.0.2",
      "minimatch": "^11.0.1"
    }
  }
}
